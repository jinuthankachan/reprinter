# reprinter web interface. Installed by `reprinter-web install`.
#
# Runs as the unprivileged "reprinter" user. That user is in the CUPS admin
# group (lpadmin on Debian, sys on Arch), which is what lets it change printers
# through the CUPS tools: CUPS checks group membership over its local socket,
# no password involved.
[Unit]
Description=reprinter web interface (print and manage printers from a browser)
Documentation=https://github.com/jinuthankachan/reprinter/blob/main/docs/web-interface.md
After=network-online.target cups.service
Wants=network-online.target cups.service

[Service]
Type=exec
User=reprinter
Group=reprinter
ExecStart=/usr/local/bin/reprinter-web --config /var/lib/reprinter/config.toml
Restart=on-failure
RestartSec=2
StateDirectory=reprinter
StateDirectoryMode=0750

# Lets listen = "0.0.0.0:80" work without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
